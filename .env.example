# Copy to .env (or .env.development for local dev) and fill in. Never commit the copy.

# Neon pooled connection string, used by the app at runtime (host contains "-pooler")
DATABASE_URL=
# Neon direct connection string, used by the Prisma CLI for migrations
DIRECT_URL=

# Auth.js signing secret; generate with `npx auth secret`
AUTH_SECRET=

# "unisms" sends real SMS; "fake" is test mode and sends nothing (default: fake)
SMS_DRIVER=
# UniSMS API secret key; required when SMS_DRIVER=unisms
UNISMS_API_KEY=
# Registered UniSMS sender ID (default: Unisoft)
UNISMS_SENDER_ID=
# Must match the Webhook Secret Key in the UniSMS dashboard; required when SMS_DRIVER=unisms
UNISMS_WEBHOOK_SECRET=
# Prepended to every SMS (default: Mi-isi FA:)
SMS_MESSAGE_PREFIX=

# The one officer account, created once by the seed script
SEED_OFFICER_EMAIL=
SEED_OFFICER_PASSWORD=
